[
  {
    "id": "dev-api",
    "name": "Development API",
    "environment": "DEV",
    "project": "my-api",
    "host": "YOUR_DEV_SERVER_IP",
    "port": 22,
    "username": "deploy",
    "privateKeyPath": "/home/ubuntu/.ssh/opsone_deploy",
    "hostKeySha256": "REPLACE_WITH_VERIFIED_SHA256_FINGERPRINT",
